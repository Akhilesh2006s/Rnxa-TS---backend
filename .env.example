# Copy to .env and fill in. .env is gitignored and must never be committed.

# MongoDB Atlas connection string. The path segment is the database name (rnxats).
# URL-encode the username and password. Atlas must allow this machine's IP
# (Network Access) and transactions need a replica set, which Atlas provides.
DATABASE_URL="mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/rnxats?retryWrites=true&w=majority&appName=Cluster0"

# Signs session cookies. Use a long random value (e.g. `openssl rand -hex 48`).
SESSION_SECRET=

# Claude API (server side only, never shipped to the browser).
ANTHROPIC_API_KEY=
# Configurable model identifier. Verify model, pricing, limits and data
# retention terms before production.
REWRITE_MODEL=claude-opus-5-5
# Request timeout for one rewrite call, in milliseconds.
REWRITE_TIMEOUT_MS=20000
# Longest description accepted for rewriting, in characters.
REWRITE_MAX_INPUT_CHARS=2000
# Per-user requests allowed per hour.
REWRITE_USER_HOURLY_LIMIT=30
# Organisation-wide monthly token budget (input + output). 0 disables the feature.
REWRITE_MONTHLY_TOKEN_BUDGET=2000000

# AI assistant (voice/chat agent with tools). Sonnet 5.5 with thinking off is the
# fast default for conversation; claude-opus-5-5 reasons more but is several times slower.
ASSISTANT_MODEL=claude-sonnet-5-5
# Model for voice mode, where time-to-first-word matters most.
ASSISTANT_VOICE_MODEL=claude-haiku-5-5
# off | adaptive. "off" disables extended thinking where the model allows it.
ASSISTANT_THINKING=off
# low | medium | high. Low keeps voice replies quick.
ASSISTANT_EFFORT=low
ASSISTANT_USER_HOURLY_LIMIT=60
ASSISTANT_MONTHLY_TOKEN_BUDGET=20000000

# HTTP
PORT=4000
SESSION_TTL_HOURS=8

# Optional super admin account (ADMIN role) created or reset by `npm run db:seed`.
SUPERADMIN_EMAIL=superadmin@rnxadigital.com
SUPERADMIN_PASSWORD=

# Password for demo users created by npm run db:demo
DEMO_PASSWORD=

# Attachments (photos, videos, documents on time entries). Files are stored on
# disk in UPLOAD_DIR (relative to the server folder); use a persistent volume in production.
UPLOAD_DIR=uploads
ATTACHMENT_MAX_MB=50
ATTACHMENT_MAX_PER_ENTRY=10

# Proxies between the browser and this API: 1 locally or on Render alone,
# 2 when the frontend on Vercel rewrites /api to Render.
TRUST_PROXY_HOPS=1
